	fragment@136 {
		target = <&thermal_zones>;

		__overlay__ {

			conn_therm2: conn_therm2 {
				polling-delay = <0x00>;
				polling-delay-passive = <0x00>;
				thermal-sensors = <&tboard_thermistor4>;
				phandle = <0x93>;

				trips {

					conn_therm2_crit: conn-therm2-crit {
						temperature = <0x1d010>;
						hysteresis = <0x7d0>;
						type = "passive";
						phandle = <0x94>;
					};
				};
			};

			display_therm: display_therm {
				polling-delay = <0x00>;
				polling-delay-passive = <0x00>;
				thermal-sensors = <&tboard_thermistor5>;
				phandle = <0x95>;

				trips {

					display_therm_crit: display-therm-crit {
						temperature = <0x1d010>;
						hysteresis = <0x7d0>;
						type = "passive";
						phandle = <0x96>;
					};
				};
			};

			conn_therm: conn_therm {
				polling-delay = <0x00>;
				polling-delay-passive = <0x00>;
				thermal-sensors = <&tboard_thermistor6>;
				phandle = <0x97>;

				trips {

					conn_therm_crit: conn-therm-crit {
						temperature = <0x1d010>;
						hysteresis = <0x7d0>;
						type = "passive";
						phandle = <0x98>;
					};
				};
			};

			quiet_therm: quiet_therm {
				polling-delay = <0x00>;
				polling-delay-passive = <0x00>;
				thermal-sensors = <&tboard_thermistor7>;
				phandle = <0x99>;

				trips {

					quiet_therm_crit: quiet-therm-crit {
						temperature = <0x1d010>;
						hysteresis = <0x7d0>;
						type = "passive";
						phandle = <0x9a>;
					};
				};
			};

			charger_therm1: charger_therm1 {
				polling-delay = <0x00>;
				polling-delay-passive = <0x00>;
				thermal-sensors = <&tboard_thermistor8>;
				phandle = <0x9b>;

				trips {

					charger_therm1_crit: charger-therm1-crit {
						temperature = <0x1d010>;
						hysteresis = <0x7d0>;
						type = "passive";
						phandle = <0x9c>;
					};
				};
			};

			wifi_therm: wifi_therm {
				polling-delay = <0x00>;
				polling-delay-passive = <0x00>;
				thermal-sensors = <&tboard_thermistor9>;
				phandle = <0x9d>;

				trips {

					wifi_therm_crit: wifi-therm-crit {
						temperature = <0x1d010>;
						hysteresis = <0x7d0>;
						type = "passive";
						phandle = <0x9e>;
					};
				};
			};

			flash_therm: flash_therm {
				polling-delay = <0x00>;
				polling-delay-passive = <0x00>;
				thermal-sensors = <&tboard_thermistor10>;
				phandle = <0x9f>;

				trips {

					flash_therm_crit: flash-therm-crit {
						temperature = <0x1d010>;
						hysteresis = <0x7d0>;
						type = "passive";
						phandle = <0xa0>;
					};
				};
			};
		};
	};

