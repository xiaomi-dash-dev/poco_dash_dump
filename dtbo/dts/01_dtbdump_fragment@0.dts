/dts-v1/;
/plugin/;

/ {

	fragment@0 {
		target = <&odm>;

		__overlay__ {

			simtray {
				compatible = "xiaomi,simtray-status";
				status-gpio = <&pio>, <0x2c 0x00>;
			};
		};
	};

	fragment@1 {
		target = <&mt6373_vrf18_aif>;

		__overlay__ {
			regulator-min-microvolt = <0x1b7740>;
			regulator-max-microvolt = <0x1b7740>;
			regulator-always-on;
		};
	};

	fragment@2 {
		target = <&irtx_pwm>;

		__overlay__ {
			pwm_ch = <0x00>;
			pinctrl-names = "irtx_gpio_led_default", "irtx_gpio_led_set";
			pinctrl-0 = <&irtx_gpio_led_default>;
			pinctrl-1 = <&irtx_gpio_led_set>;
			status = "okay";
		};
	};

	fragment@3 {
		target = <&pio>;

		__overlay__ {

			irtx_gpio_led_default: irtx_gpio_led_def@gpio110 {
				phandle = <0x01>;

				pins_cmd_dat {
					pinmux = <0x6e00>;
					slew-rate = <0x01>;
					bias-disable;
					output-low;
					input-schmitt-enable = <0x00>;
				};
			};

			irtx_gpio_led_set: irtx_gpio_led_set@gpio110 {
				phandle = <0x02>;

				pins_cmd_dat {
					pinmux = <0x6e02>;
					slew-rate = <0x01>;
					output-high;
				};
			};
		};
	};

	fragment@4 {
		target = <&i2c8>;

		__overlay__ {

			aw21024_led@30 {
				compatible = "awinic,aw21024_led";
				reg = <0x30>;
				reset-gpio = <&pio>, <0x1a 0x00>;
				apse_mode;
				clk_pwm = <0x01>;
				max_brightness = <0xff>;
				led_current = <0x7f>;
				led_wbr = <0xff>;
				led_wbg = <0xff>;
				led_wbb = <0xbf>;
				brightness = <0x7d>;
				status = "okay";
			};
		};
	};

	fragment@5 {
		target = <&i2c3>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0x33e140>;

			nxp@28 {
				compatible = "qcom,nq-nci";
				reg = <0x28>;
				qcom,nq-irq = <&pio>, <0xe1 0x00>;
				interrupt-parent = <&pio>;
				interrupts = <0xe1 0x04 0xe1 0x00>;
				qcom,nq-ven = <&pio>, <0x12 0x00>;
				qcom,nq-clkreq = <&pio>, <0x0f 0x00>;
				interrupt-names = "nfc_irq";
				pinctrl-names = "default", "nfc_active", "nfc_suspend";
				pinctrl-0 = <&nfc_default>;
				pinctrl-1 = <&nfc_int_active>, <&nfc_enable_active>, <&nfc_clk_req_active>;
				pinctrl-2 = <&nfc_int_suspend>, <&nfc_enable_suspend>, <&nfc_clk_req_suspend>;
			};
		};
	};

	fragment@6 {
		target = <&pio>;

		__overlay__ {

			nfc_default: nfc_default {
				phandle = <0x03>;
			};

			nfc_int_active: nfc_int_active {
				phandle = <0x04>;

				pins_cmd_dat {
					pinmux = <0xe100>;
					slew-rate = <0x00>;
					drive-strength = <0x02>;
					bias-pull-up;
				};
			};

			nfc_int_suspend: nfc_int_suspend {
				phandle = <0x07>;

				pins_cmd_dat {
					pinmux = <0xe100>;
					slew-rate = <0x00>;
					drive-strength = <0x02>;
					bias-pull-up;
				};
			};

			nfc_enable_active: nfc_enable_active {
				phandle = <0x05>;

				pins_cmd_dat {
					pinmux = <0x1200>;
					slew-rate = <0x01>;
					output-high;
					drive-strength = <0x02>;
					bias-pull-up = <0x67>;
				};
			};

			nfc_enable_suspend: nfc_enable_suspend {
				phandle = <0x08>;

				pins_cmd_dat {
					pinmux = <0x1200>;
					slew-rate = <0x01>;
					drive-strength = <0x02>;
					bias-disable;
				};
			};

			nfc_firmwaredownload_active: nfc_firmwaredownload_active {
				phandle = <0x7a>;

				pins_cmd_dat {
					pinmux = <0x1300>;
					slew-rate = <0x01>;
					drive-strength = <0x02>;
					bias-pull-up;
				};
			};

			nfc_firmwaredownload_suspend: nfc_firmwaredownload_suspend {
				phandle = <0x7b>;

				pins_cmd_dat {
					pinmux = <0x1300>;
					slew-rate = <0x01>;
					drive-strength = <0x02>;
					bias-disable;
				};
			};

			nfc_clk_req_active: nfc_clk_req_active {
				phandle = <0x06>;

				pins_cmd_dat {
					pinmux = <0xf01>;
					slew-rate = <0x00>;
					input-enable;
					drive-strength = <0x02>;
					bias-pull-up;
				};
			};

			nfc_clk_req_suspend: nfc_clk_req_suspend {
				phandle = <0x09>;

				pins_cmd_dat {
					pinmux = <0xf01>;
					slew-rate = <0x00>;
					input-enable;
					drive-strength = <0x02>;
					bias-pull-down;
				};
			};
		};
	};

	fragment@7 {
		target = <&spi5>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			p61@31 {
				compatible = "nxp,p61";
				reg = <0x00>;
				nxp,nfcc = "3-0028";
				spi-max-frequency = <0x7a1200>;
				status = "okay";
				pinctrl-names = "nxp_ese_spi_mode";
				pinctrl-0 = <&nxp_ese_spi_mode>;
			};
		};
	};

	fragment@8 {
		target = <&pio>;

		__overlay__ {

			nxp_ese_spi_mode: nxp_ese_spi_mode {
				phandle = <0x0a>;

				pins_cmd_dat {
					pinmux = <0x7901 0x7801 0x7601 0x7701>;
					drive-strength = <0x06>;
				};
			};
		};
	};

	fragment@9 {
		target = <&pio>;

		__overlay__ {

			t1_gpio_vc_all: t1_gpio_vc_all {
				phandle = <0x0b>;

				pins_cmd_dat {
					pinmux = <0x1600 0x1500>;
					drive-strength = <0x02>;
					bias-disable;
					output-low;
				};
			};
		};
	};

	fragment@10 {
		target = <&odm>;

		__overlay__ {

			mi_t1_chip {
				compatible = "mdm,mi_t1_chip";
				gpio-count = <0x02>;
				first-gpio = <0x16>;
				mi-t1-gpio-1 = <&pio>, <0x16 0x00>;
				mi-t1-gpio-2 = <&pio>, <0x15 0x00>;
				pinctrl-names = "t1_gpio_vc_all";
				pinctrl-0 = <&t1_gpio_vc_all>;
			};
		};
	};

	fragment@11 {
		target = <&chosen>;

		__overlay__ {
			bootargs_ext = "cpufreq.default_governor=conservative \t\trcu_nocbs=0-7";
			bootargs_ext_fac = "cpufreq.default_governor=conservative \t\trcu_nocbs=0-7";
		};
	};

	fragment@12 {
		target = <&mtk_leds>;

		__overlay__ {
			compatible = "mediatek,disp-leds";

			backlight {
				max-brightness = <0x3fff>;
				min-brightness = <0x01>;
				max-hw-brightness = <0x3fff>;
				led_mode = <0x04>;
				default-state = "FifteenPercent";
			};
		};
	};

	fragment@13 {
		target = <&mt6363keys>;

		__overlay__ {
			power-off-time-sec = <0x01>;
		};
	};

	fragment@14 {
		target = <&odm>;

		__overlay__ {

			thermal_message: thermal-message {
				board-sensor = "VIRTUAL-SENSOR";
				phandle = <0x7c>;
			};
		};
	};

	fragment@15 {
		target = <&mmqos>;

		__overlay__ {
			r-hrt-ostdl = <0x02>;
		};
	};

	fragment@16 {
		target = <&mt6373_adc>;

		__overlay__ {

			vin1-open {
				channel = <0x13>;
				pures = <0x00>;
			};

			vin2-open {
				channel = <0x14>;
				pures = <0x00>;
			};

			vin4-open {
				channel = <0x16>;
				pures = <0x00>;
			};

			vin5-open {
				channel = <0x17>;
				pures = <0x00>;
			};
		};
	};

	fragment@17 {
		target = <&ise_mbox>;

		__overlay__ {
			mediatek,real-drv = <0x00>;
		};
	};

	fragment@18 {
		target = <&ise_lpm>;

		__overlay__ {
			ise-wakelock = <0x00>;
			ise-lpm-freerun = <0x00>;
			ise-lpm-deinit-bypass = <0x00>;
			power-domains = <&scpsys>, <0x12>;
		};
	};

	fragment@19 {
		target = <&ise_trusty>;

		__overlay__ {
			mediatek,real-drv = <0x00>;
		};
	};

	fragment@20 {
		target = <&pmic_adc>;

		__overlay__ {

			vin3_100k {
				channel = <0x15>;
				pures = <0x00>;
			};

			vin4_open {
				channel = <0x16>;
				pures = <0x00>;
			};

			vin6_100k {
				channel = <0x18>;
				pures = <0x00>;
			};

			vin7_100k {
				channel = <0x19>;
				pures = <0x00>;
			};
		};
	};

	fragment@21 {
		target = <&rt5133>;

		__overlay__ {
			status = "disabled";
		};
	};

	fragment@22 {
		target = <&rt5133_gpio1>;

		__overlay__ {
			status = "disabled";
		};
	};

	fragment@23 {
		target = <&rt5133_gpio2>;

		__overlay__ {
			status = "disabled";
		};
	};

	fragment@24 {
		target = <&rt5133_gpio3>;

		__overlay__ {
			status = "disabled";
		};
	};

	fragment@25 {
		target = <&rt6160_bob>;

		__overlay__ {
			status = "disabled";
		};
	};

	fragment@26 {
		target = <&pio>;

		__overlay__ {

			mtkfb_pins_lcd_bias_enp1: lcd-bias-enp1-gpio {
				phandle = <0x0c>;

				pins-cmd-dat {
					pinmux = <0x6700>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			mtkfb_pins_lcd_bias_enp0: lcd-bias-enp0-gpio {
				phandle = <0x0d>;

				pins-cmd-dat {
					pinmux = <0x6700>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			mtkfb_pins_lcd_bias_enn1: lcd-bias-enn1-gpio {
				phandle = <0x0e>;

				pins-cmd-dat {
					pinmux = <0x6700>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			mtkfb_pins_lcd_bias_enn0: lcd-bias-enn0-gpio {
				phandle = <0x0f>;

				pins-cmd-dat {
					pinmux = <0x6700>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			mtkfb_pins_lcm_rst_out1_gpio: lcm-rst-out1-gpio {
				phandle = <0x10>;

				pins-cmd-dat {
					pinmux = <0x5a00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			mtkfb_pins_lcm_rst_out0_gpio: lcm-rst-out0-gpio {
				phandle = <0x11>;

				pins-cmd-dat {
					pinmux = <0x5a00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			mtkfb_pins_lcm_dsi_te: lcm-dsi-te {
				phandle = <0x12>;

				pins-cmd-dat {
					pinmux = <0x5901>;
				};
			};

			mtkfb_pins_lcm_led_en1: lcm-led-en1-gpio {
				phandle = <0x13>;

				pins-cmd-dat {
					pinmux = <0xae00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			mtkfb_pins_lcm_led_en0: lcm-led-en0-gpio {
				phandle = <0x14>;

				pins-cmd-dat {
					pinmux = <0xae00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			mtkfb_pins_lcm_dsi1_te: lcm-dsi1-te {
				phandle = <0x15>;

				pins-cmd-dat {
					pinmux = <0x601>;
				};
			};
		};
	};

	fragment@27 {
		target = <&mtkfb>;

		__overlay__ {
			pinctrl-names = "lcd_bias_enp1_gpio", "lcd_bias_enp0_gpio", "lcd_bias_enn1_gpio", "lcd_bias_enn0_gpio", "lcm_rst_out1_gpio", "lcm_rst_out0_gpio", "mode_te_te", "lcm_led_en1_gpio", "lcm_led_en0_gpio", "mode_te_te1";
			pinctrl-0 = <&mtkfb_pins_lcd_bias_enp1>;
			pinctrl-1 = <&mtkfb_pins_lcd_bias_enp0>;
			pinctrl-2 = <&mtkfb_pins_lcd_bias_enn1>;
			pinctrl-3 = <&mtkfb_pins_lcd_bias_enn0>;
			pinctrl-4 = <&mtkfb_pins_lcm_rst_out1_gpio>;
			pinctrl-5 = <&mtkfb_pins_lcm_rst_out0_gpio>;
			pinctrl-6 = <&mtkfb_pins_lcm_dsi_te>;
			pinctrl-7 = <&mtkfb_pins_lcm_led_en1>;
			pinctrl-8 = <&mtkfb_pins_lcm_led_en0>;
			pinctrl-9 = <&mtkfb_pins_lcm_dsi1_te>;
			status = "okay";
		};
	};

	fragment@28 {
		target = <&dispsys_config>;

		__overlay__ {
			pinctrl-names = "mode_te_te", "mode_te_te1";
			pinctrl-0 = <&mtkfb_pins_lcm_dsi_te>;
			pinctrl-1 = <&mtkfb_pins_lcm_dsi1_te>;
			status = "okay";
			helper-name-proj = "MTK_DRM_OPT_IDLEMGR_DISABLE_ROUTINE_IRQ", "MTK_DRM_OPT_MML_DL_SUB_CFG_CLINET", "MTK_DRM_OPT_OVL_WCG", "MTK_DRM_OPT_OVL_WCG_BY_COLOR_MODE", "MTK_DRM_OPT_DSI_UNDERRUN_AEE";
			helper-value-proj = <0x01 0x01 0x01 0x01 0x01>;
		};
	};

	fragment@29 {
		target = <&disp_dpc>;

		__overlay__ {
			vidle-mask = <0x00>;
		};
	};

	fragment@30 {
		target = <&mipi_tx_config1>;

		__overlay__ {
		};
	};

	fragment@31 {
		target = <&dsi1>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			init-panel-off;

			panel1@0 {
				compatible = "truly,td4330,cmd";
				reg = <0x00>;
				pm-enable-gpios = <&pio>, <0xd7 0x00>;
				reset-gpios = <&pio>, <0x05 0x00>;
				swap-from-dts;
				lane-swap-setting = <0x01 0x02 0x00 0x03 0x04 0x02>;
				pn-swap-setting = <0x01 0x01 0x01 0x01 0x01 0x01>;
				gate-ic = <0x12df>;
				pinctrl-names = "default";

				port {

					panel1_in: endpoint {
						remote-endpoint = <&dsi1_out>;
						phandle = <0x1a>;
					};
				};
			};

			panel2@1 {
				compatible = "jdi,nt36672e,vdo,120hz";
				reg = <0x01>;
				pm-enable-gpios = <&pio>, <0xd7 0x00>;
				reset-gpios = <&pio>, <0x05 0x00>;
				gate-ic = <0x12df>;
				pinctrl-names = "default";

				port {

					panel2_in: endpoint {
						remote-endpoint = <&dsi1_out2>;
						phandle = <0x1b>;
					};
				};
			};

			panel3@2 {
				compatible = "jdi,nt36672e,cphy,vdo";
				reg = <0x02>;
				pm-enable-gpios = <&pio>, <0xd7 0x00>;
				reset-gpios = <&pio>, <0x05 0x00>;
				gate-ic = <0x12df>;
				pinctrl-names = "default";

				port {

					panel3_in: endpoint {
						remote-endpoint = <&dsi1_out3>;
						phandle = <0x1c>;
					};
				};
			};

			panel4@3 {
				compatible = "jdi,nt36672e,vdo,60hz";
				reg = <0x03>;
				pm-enable-gpios = <&pio>, <0xd7 0x00>;
				reset-gpios = <&pio>, <0x05 0x00>;
				gate-ic = <0x12df>;
				pinctrl-names = "default";

				port {

					panel4_in: endpoint {
						remote-endpoint = <&dsi1_out4>;
						phandle = <0x1d>;
					};
				};
			};

			ports {

				port {

					dsi1_out: endpoint@0 {
						remote-endpoint = <&panel1_in>;
						phandle = <0x16>;
					};

					dsi1_out2: endpoint@1 {
						remote-endpoint = <&panel2_in>;
						phandle = <0x17>;
					};

					dsi1_out3: endpoint@2 {
						remote-endpoint = <&panel3_in>;
						phandle = <0x18>;
					};

					dsi1_out4: endpoint@3 {
						remote-endpoint = <&panel4_in>;
						phandle = <0x19>;
					};
				};
			};
		};
	};

	fragment@32 {
		target = <&dsi1_te>;

		__overlay__ {
			interrupt-parent = <&pio>;
			interrupts = <0x06 0x01 0x06 0x01>;
			status = "okay";
		};
	};

	fragment@33 {
		target = <&dsi0>;

		__overlay__ {
			switch-spr = <0x01>;
			spr-ip-type = <0x00>;
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			dash_42_02_0a_dsc_vdo: panel1@0 {
				compatible = "p10u_42_02_0a_dsc_vdo,lcm";
				reg = <0x00>;
				reset-gpios = <&pio>, <0x5a 0x00>;
				mi,esd-err-irq-gpio = <&pio>, <0x06 0x2002>;
				res-switch = <0x02>;
				pinctrl-names = "default";
				vcn18io-supply = <&mt6373_vcn18io>;
				vibr-supply = <&mt6373_vibr>;
				amoled-dvdd-supply = <&mt6363_vcn13>;
				phandle = <0x31>;

				port {

					panel_in1: endpoint {
						remote-endpoint = <&dsi_out>;
						phandle = <0x20>;
					};
				};
			};

			dash_36_02_0b_dsc_vdo: panel2@1 {
				compatible = "p10u_36_02_0b_dsc_vdo,lcm";
				reg = <0x01>;
				reset-gpios = <&pio>, <0x5a 0x00>;
				mi,esd-err-irq-gpio = <&pio>, <0x06 0x2002>;
				res-switch = <0x02>;
				pinctrl-names = "default";
				vcn18io-supply = <&mt6373_vcn18io>;
				vibr-supply = <&mt6373_vibr>;
				amoled-dvdd-supply = <&mt6363_vcn13>;
				phandle = <0x32>;

				port {

					panel_in2: endpoint {
						remote-endpoint = <&dsi_out2>;
						phandle = <0x21>;
					};
				};
			};

			ports {

				port {

					dsi_out: endpoint {
						remote-endpoint = <&panel_in1>;
						phandle = <0x1e>;
					};

					dsi_out2: endpoint2 {
						remote-endpoint = <&panel_in2>;
						phandle = <0x1f>;
					};
				};
			};
		};
	};

	fragment@34 {
		target = <&pio>;

		__overlay__ {

			rptr_enable: rptr-enable {
				phandle = <0x22>;

				pins-cmd-dat {
					pinmux = <0x4800>;
					output-high;
				};
			};

			rptr_disable: rptr-disable {
				phandle = <0x23>;

				pins-cmd-dat {
					pinmux = <0x4800>;
					output-low;
				};
			};
		};
	};

	fragment@35 {
		target = <&ssusb>;

		__overlay__ {
			mediatek,force-vbus;
			mediatek,clk-mgr;
			mediatek,usb3-drd;
			mediatek,uds = <&usb_dp_selector>, <0x13>;
			mediatek,eusb2-cm-l1 = <0x474>;
			usb-role-switch;
			status = "okay";
		};
	};

	fragment@36 {
		target = <&usb_host>;

		__overlay__ {
			mediatek,usb-offload = <&usb_offload>;
			status = "okay";
		};
	};

	fragment@37 {
		target = <&mt6379_eusb2_repeater>;

		__overlay__ {
			status = "okay";
			mediatek,param-override-seq = <0x01 0x06 0x02 0x04 0x03 0x04 0x04 0x05 0x05 0x05 0x06 0x00 0x07 0x00>;
			mediatek,param-override-seq-factory = <0x01 0x06 0x02 0x04 0x03 0x04 0x04 0x05 0x05 0x05 0x06 0x00 0x07 0x00>;
