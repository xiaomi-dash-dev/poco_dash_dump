			pcie0_pins_init: pcie0-init {
				phandle = <0x24>;

				pins-cmd-dat {
					pinmux = <0xf100>;
					output-low;
				};

				pins-cmd-dat1 {
					pinmux = <0xf300>;
					bias-pull-up;
					input-enable;
				};

				pins-cmd-dat2 {
					pinmux = <0xf200>;
					bias-pull-down;
					input-enable;
				};
			};

			pcie0_pins_default: pcie0-default {
				phandle = <0x25>;

				pins-cmd-dat {
					pinmux = <0xf101 0xf301>;
					bias-pull-up;
				};

				pins-cmd-dat1 {
					pinmux = <0xf200>;
					bias-pull-down;
					input-enable;
				};
			};

			pcie0_pins_sleep: pcie0-sleep {
				phandle = <0x26>;

				pins-cmd-dat {
					pinmux = <0xf100>;
					output-low;
				};

				pins-cmd-dat1 {
					pinmux = <0xf300>;
					bias-pull-up;
					input-enable;
				};

				pins-cmd-dat2 {
					pinmux = <0xf200>;
					bias-pull-down;
					input-enable;
				};
			};

			pcie0_pins_pd: pcie0-pd {
				phandle = <0x27>;

				pins-cmd-dat {
					pinmux = <0xf100>;
					output-low;
				};

				pins-cmd-dat1 {
					pinmux = <0xf300 0xf200>;
					bias-pull-down;
					input-enable;
				};
			};

			pcie1_pins_default: pcie1-default {
				phandle = <0x28>;

				pins-cmd-dat {
					pinmux = <0x9104 0x9204 0x9304>;
					bias-pull-up = <0x65>;
				};
			};
		};
