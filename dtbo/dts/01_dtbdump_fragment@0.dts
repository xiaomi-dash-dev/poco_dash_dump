	fragment@105 {
		target = <&odm>;

		__overlay__ {

			xiaomi_touch: xiaomi_touch {
				compatible = "xiaomi-touch";
				status = "ok";
				touch,name = "xiaomi-touch";
				panel = <&dash_42_02_0a_dsc_vdo>, <&dash_36_02_0b_dsc_vdo>;
				phandle = <0x82>;
			};
		};
	};

	fragment@106 {
		target = <&pio>;

		__overlay__ {

			mi_ts_spi_active: mi_ts_spi_active {
				phandle = <0x33>;

				pins_cmd_dat {
					pinmux = <0x5402 0x5202 0x5302 0x5102>;
					drive-strength = <0x04>;
				};
			};

			mi_ts_spi_suspend: mi_ts_spi_suspend {
				phandle = <0x35>;

				pins_cmd_dat {
					pinmux = <0x5100>;
					bias-pull-down;
				};
			};

			ts_int_active: ts_int_active {
				phandle = <0x34>;

				pins_cmd_dat {
					pinmux = <0x700>;
					input-enable;
					bias-disable;
				};
			};

			ts_cs_suspend: ts_cs_suspend {
				phandle = <0x37>;

				pins_cmd_dat {
					pinmux = <0x5200>;
					bias-pull-down;
				};
			};

			ts_int_suspend: ts_int_suspend {
				phandle = <0x36>;

				pins_cmd_dat {
					pinmux = <0x700>;
					bias-pull-down;
				};
			};
		};
	};

	fragment@107 {
		target = <&spi6>;

		__overlay__ {
			status = "ok";

			novatek@0 {
				compatible = "novatek,NVT-ts-spi";
				reg = <0x00>;
				status = "ok";
				interrupt-parent = <&pio>;
				interrupts = <0x07 0x2008>;
				spi-max-frequency = <0x124f800>;
				pinctrl-names = "pmx_ts_active", "pmx_ts_suspend";
				pinctrl-0 = <&mi_ts_spi_active>, <&ts_int_active>;
				pinctrl-1 = <&mi_ts_spi_suspend>, <&ts_int_suspend>, <&ts_cs_suspend>;
				novatek,irq-gpio = <&pio>, <0x07 0x2008>;
				novatek,lcd_id-gpio1 = <&pio>, <0xb8 0x00>;
				novatek,lcd_id-gpio2 = <&pio>, <0xb7 0x00>;
				spi-cs-setup-delay-ns = <0x12c>;
				spi-cs-hold-delay-ns = <0x12c>;
				mi_tp,game-mode-array = <0x01 0x00 0x00 0x00 0x00>;
				mi_tp,active-mode-array = <0x01 0x00 0x00 0x00 0x00>;
				mi_tp,tolerance-array = <0x04 0x00 0x02 0x02 0x02>;
				mi_tp,up-threshold-array = <0x04 0x00 0x03 0x03 0x03>;
				mi_tp,aim-sensitivity-array = <0x04 0x00 0x02 0x02 0x02>;
				mi_tp,tap-stability-array = <0x04 0x00 0x02 0x02 0x02>;
				mi_tp,edge-filter-array = <0x03 0x00 0x02 0x02 0x02>;
				mi_tp,panel-orien-array = <0x03 0x00 0x00 0x00 0x00>;
				mi_tp,report-rate-array = <0x03 0x00 0x00 0x00 0x00>;
				mi_tp,expert-mode-array = <0x03 0x01 0x01 0x01 0x01>;
			};
		};
	};

	fragment@108 {
		target = <&seninf_top>;

		__overlay__ {

			seninf_csi_port_3: seninf-csi-port-3 {
				compatible = "mediatek,seninf";
				csi-port = "3";
				nvmem-cells = <&csi_efuse3>;
				nvmem-cell-names = "rg_csi";
				phandle = <0x83>;

				port {

					seninf_csi_port_3_in: endpoint {
						remote-endpoint = <&sensor1_out>;
						phandle = <0x67>;
					};
				};
			};

			seninf_csi_port_4: seninf-csi-port-4 {
				compatible = "mediatek,seninf";
				csi-port = "4";
				nvmem-cells = <&csi_efuse4>;
				nvmem-cell-names = "rg_csi";
				phandle = <0x84>;

				port {

					seninf_csi_port_4_in: endpoint {
						remote-endpoint = <&sensor0_out>;
						phandle = <0x49>;
					};
				};
			};

			seninf_csi_port_5: seninf-csi-port-5 {
				compatible = "mediatek,seninf";
				csi-port = "5";
				nvmem-cells = <&csi_efuse5>;
				nvmem-cell-names = "rg_csi";
				phandle = <0x85>;

				port {

					seninf_csi_port_5_in: endpoint {
						remote-endpoint = <&sensor2_out>;
						phandle = <0x58>;
					};
				};
			};
		};
	};

	fragment@109 {
		target = <&mt6373_vbuck8>;

		__overlay__ {
			regulator-compatible = "VBUCK8";
			regulator-name = "mt6373_vbuck8";
			regulator-min-microvolt = <0x493e0>;
			regulator-max-microvolt = <0x186a00>;
			regulator-enable-ramp-delay = <0xc8>;
			regulator-allowed-modes = <0x00 0x01 0x02>;
			regulator-always-on;
		};
	};

	fragment@110 {
		target = <&odm>;

		__overlay__ {

			camera_wide_dvdd: camera-wide-dvdd {
				compatible = "regulator-fixed";
				regulator-name = "camera-wide-dvdd";
				regulator-min-microvolt = <0x124f80>;
				regulator-max-microvolt = <0x124f80>;
				gpio = <&pio>, <0xb4 0x00>;
				enable-active-high;
				phandle = <0x47>;
			};
		};
	};

	fragment@111 {
		target = <&pio>;

		__overlay__ {

			camera_pins_cam0_mclk_off: camera-pins-cam0-mclk-off {
				phandle = <0x3b>;

				pins-cmd-dat {
					pinmux = <0xc400>;
					drive-strength = <0x01>;
				};
			};

			camera_pins_cam0_mclk_2ma: camera-pins-cam0-mclk-2ma {
				phandle = <0x3c>;

				pins-cmd-dat {
					pinmux = <0xc401>;
					drive-strength = <0x00>;
				};
			};

			camera_pins_cam0_mclk_4ma: camera-pins-cam0-mclk-4ma {
				phandle = <0x3d>;

				pins-cmd-dat {
					pinmux = <0xc401>;
					drive-strength = <0x01>;
				};
			};

			camera_pins_cam0_mclk_6ma: camera-pins-cam0-mclk-6ma {
				phandle = <0x3e>;

				pins-cmd-dat {
					pinmux = <0xc401>;
					drive-strength = <0x02>;
				};
			};

			camera_pins_cam0_mclk_8ma: camera-pins-cam0-mclk-8ma {
				phandle = <0x3f>;

				pins-cmd-dat {
					pinmux = <0xc401>;
					drive-strength = <0x03>;
				};
			};

			camera_pins_cam0_rst_0: cam0@0 {
				phandle = <0x40>;

				pins-cmd-dat {
					pinmux = <0xc500>;
					drive-strength = <0x00>;
					output-low;
				};
			};

			camera_pins_cam0_rst_1: cam0@1 {
				phandle = <0x41>;

				pins-cmd-dat {
					pinmux = <0xc500>;
					drive-strength = <0x01>;
					output-high;
				};
			};

			camera_pins_cam0_scl_ap: cam0@2 {
				phandle = <0x42>;

				pins-cmd-dat {
					pinmux = <0xbc00>;
					drive-strength = <0x00>;
					output-low;
					bias-pull-down;
				};
			};

			camera_pins_cam0_scl_scp: cam0@3 {
				phandle = <0x43>;

				pins-cmd-dat {
					pinmux = <0xbc01>;
					bias-pull-up;
					input-enable;
				};
			};

			camera_pins_cam0_sda_ap: cam0@4 {
				phandle = <0x44>;

				pins-cmd-dat {
					pinmux = <0xbd00>;
					drive-strength = <0x00>;
					output-low;
					bias-pull-down;
				};
			};

			camera_pins_cam0_sda_scp: cam0@5 {
				phandle = <0x45>;

				pins-cmd-dat {
					pinmux = <0xbd01>;
					input-enable;
					bias-pull-up;
				};
			};

			camera_pins_cam1_mclk_off: camera-pins-cam1-mclk-off {
				phandle = <0x59>;

				pins-cmd-dat {
					pinmux = <0x4f00>;
					drive-strength = <0x01>;
				};
			};

			camera_pins_cam1_mclk_2ma: camera-pins-cam1-mclk-2ma {
				phandle = <0x5a>;

				pins-cmd-dat {
					pinmux = <0x4f01>;
					drive-strength = <0x00>;
				};
			};

			camera_pins_cam1_mclk_4ma: camera-pins-cam1-mclk-4ma {
				phandle = <0x5b>;

				pins-cmd-dat {
					pinmux = <0x4f01>;
					drive-strength = <0x01>;
				};
			};

			camera_pins_cam1_mclk_6ma: camera-pins-cam1-mclk-6ma {
				phandle = <0x5c>;

				pins-cmd-dat {
					pinmux = <0x4f01>;
					drive-strength = <0x02>;
				};
			};

			camera_pins_cam1_mclk_8ma: camera-pins-cam1-mclk-8ma {
				phandle = <0x5d>;

				pins-cmd-dat {
					pinmux = <0x4f01>;
					drive-strength = <0x03>;
				};
			};

			camera_pins_cam1_rst_0: cam1@0 {
				phandle = <0x5e>;

				pins-cmd-dat {
					pinmux = <0xcc00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			camera_pins_cam1_rst_1: cam1@1 {
				phandle = <0x5f>;

				pins-cmd-dat {
					pinmux = <0xcc00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			camera_pins_cam1_scl_ap: cam1@2 {
				phandle = <0x60>;

				pins-cmd-dat {
					pinmux = <0xca01>;
					bias-pull-up;
				};
			};

			camera_pins_cam1_scl_scp: cam1@3 {
				phandle = <0x61>;

				pins-cmd-dat {
					pinmux = <0xca02>;
					bias-pull-up;
				};
			};

			camera_pins_cam1_sda_ap: cam1@4 {
				phandle = <0x62>;

				pins-cmd-dat {
					pinmux = <0xcb01>;
					bias-pull-up;
				};
			};

			camera_pins_cam1_sda_scp: cam1@5 {
				phandle = <0x63>;

				pins-cmd-dat {
					pinmux = <0xcb02>;
					bias-pull-up;
				};
			};

			camera_pins_cam1_eint: cam1@6 {
				phandle = <0x64>;

				pins-cmd-dat {
					pinmux = <0x2900>;
					bias-pull-up;
					input-enable;
				};
			};

			camera_pins_cam2_mclk_off: camera-pins-cam2-mclk-off {
				phandle = <0x4b>;

				pins-cmd-dat {
					pinmux = <0x5000>;
					drive-strength = <0x01>;
				};
			};

			camera_pins_cam2_mclk_2ma: camera-pins-cam2-mclk-2ma {
				phandle = <0x4c>;

				pins-cmd-dat {
					pinmux = <0x5001>;
					drive-strength = <0x00>;
				};
			};

			camera_pins_cam2_mclk_4ma: camera-pins-cam2-mclk-4ma {
				phandle = <0x4d>;

				pins-cmd-dat {
					pinmux = <0x5001>;
					drive-strength = <0x01>;
				};
			};

			camera_pins_cam2_mclk_6ma: camera-pins-cam2-mclk-6ma {
				phandle = <0x4e>;

				pins-cmd-dat {
					pinmux = <0x5001>;
					drive-strength = <0x02>;
				};
			};

			camera_pins_cam2_mclk_8ma: camera-pins-cam2-mclk-8ma {
				phandle = <0x4f>;

				pins-cmd-dat {
					pinmux = <0x5001>;
					drive-strength = <0x03>;
				};
			};

			camera_pins_cam2_rst_0: cam2@0 {
				phandle = <0x50>;

				pins-cmd-dat {
					pinmux = <0xbb00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			camera_pins_cam2_rst_1: cam2@1 {
				phandle = <0x51>;

				pins-cmd-dat {
					pinmux = <0xbb00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			camera_pins_cam2_scl_ap: cam2@2 {
				phandle = <0x52>;

				pins-cmd-dat {
					pinmux = <0xbe00>;
					drive-strength = <0x00>;
					output-low;
					bias-pull-down;
				};
			};

			camera_pins_cam2_scl_scp: cam2@3 {
				phandle = <0x53>;

				pins-cmd-dat {
					pinmux = <0xbe01>;
					bias-pull-up;
					input-enable;
				};
			};

			camera_pins_cam2_sda_ap: cam2@4 {
				phandle = <0x54>;

				pins-cmd-dat {
					pinmux = <0xbf00>;
					drive-strength = <0x00>;
					output-low;
					bias-pull-down;
				};
			};

			camera_pins_cam2_sda_scp: cam2@5 {
				phandle = <0x55>;

				pins-cmd-dat {
					pinmux = <0xbf01>;
					input-enable;
					bias-pull-up;
				};
			};
		};
	};

	fragment@112 {
		target = <&i2c2>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0xf4240>;

			sensor0: sensor0@10 {
				compatible = "mediatek,imgsensor";
				sensor-names = "dashscx6000wide_mipi_raw";
				reg = <0x10>;
				#thermal-sensor-cells = <0x00>;
				pinctrl-names = "mclk_off", "mclk_2mA", "mclk_4mA", "mclk_6mA", "mclk_8mA", "rst_low", "rst_high", "scl_ap", "scl_scp", "sda_ap", "sda_scp";
				pinctrl-0 = <&camera_pins_cam0_mclk_off>;
				pinctrl-1 = <&camera_pins_cam0_mclk_2ma>;
				pinctrl-2 = <&camera_pins_cam0_mclk_4ma>;
