		compatible = "arm,physical-memory-group-manager";
		phandle = <0x165>;
	};

	gpu_protected_memory_allocator: protected-memory-allocator {
		compatible = "arm,protected-memory-allocator";
		pma-version = <0x02>;
		gpr-id = <0x06>;
		gmpu-table-size = <0x00>;
		protected-reserve-size = <0x200000>;
		disable-init-gpu-iommu = <0x00>;
		gpufreq-supply = <0xa9>;
		phandle = <0x166>;

		gpu-iommu {
			compatible = "mediatek,gpu-iommu";
			iommus = <0xaa 0x01>;
			mtk,smmu-dma-mode = "disable";
		};

		gpu-iommu-protected {
			compatible = "mediatek,gpu-iommu";
			iommus = <0xaa 0x02>;
			mtk,smmu-dma-mode = "disable";
		};
