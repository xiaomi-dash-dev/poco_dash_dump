				debounce = <0x0d>;
				strategy = <0x00>;
				ignore-urgent = <0x00>;
				phandle = <0x6a>;
			};
		};

		monitor-channel-list {

			ch_0: ch-0 {
				sig-sel = <0x00>;
				bit-sel = <0x1a>;
				trig-type = <0x03>;
				phandle = <0x6b>;
