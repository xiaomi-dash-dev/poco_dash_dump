				port@2 {
					reg = <0x02>;

					funnel0_in2: endpoint {
						remote-endpoint = <0x1b8>;
						phandle = <0x1b0>;
					};
				};

				port@3 {
					reg = <0x03>;

					funnel0_in3: endpoint {
						remote-endpoint = <0x1b9>;
						phandle = <0x1b1>;
					};
				};

				port@4 {
					reg = <0x04>;

					funnel0_in4: endpoint {
						remote-endpoint = <0x1ba>;
						phandle = <0x1b2>;
					};
				};

				port@5 {
					reg = <0x05>;

					funnel0_in5: endpoint {
						remote-endpoint = <0x1bb>;
						phandle = <0x1b3>;
					};
				};

				port@6 {
					reg = <0x06>;

					funnel0_in6: endpoint {
						remote-endpoint = <0x1bc>;
						phandle = <0x1b4>;
					};
				};

				port@7 {
					reg = <0x07>;

					funnel0_in7: endpoint {
						remote-endpoint = <0x1bd>;
						phandle = <0x1b5>;
					};
				};
			};

			out-ports {

				port {

					funnel0_out: endpoint {
						remote-endpoint = <0x1be>;
						phandle = <0x1a3>;
					};
				};
			};
		};

