		compatible = "mediatek,mt6991-pextp0cfg_ao", "syscon", "simple-mfd";
		reg = <0x00 0x169b0000 0x00 0x1000>;
		#clock-cells = <0x01>;
		phandle = <0x28>;

		pextp0ao_rst: reset-controller {
			compatible = "ti,syscon-reset";
			#reset-cells = <0x01>;
			ti,reset-bits = <0x08 0x00 0x0c 0x00 0x00 0x00 0x1c 0x08 0x01 0x0c 0x01 0x00 0x00 0x1c>;
			phandle = <0x17c>;
