					bat,nr = <0x01>;

					bat-info0 {
						bat,vid = <0x2717>;
						bat,pid = <0x6379>;
						bat,mfrs = "bat1";
						bat,design-cap = <0xbb8>;
					};
				};

				dpm-caps {
					local-dr-power;
					local-dr-data;
					local-usb-comm;
					local-no-suspend;
					attempt-enter-dp-mode;
					pr-check = <0x00>;
					dr-check = <0x00>;
				};

				displayport {
					1st-connection = "dfp-d";
					2nd-connection = "dfp-d";
					typec,receptacle;

					ufp-d {
					};

					dfp-d {
						pin-assignment,mode-c;
						pin-assignment,mode-d;
						pin-assignment,mode-e;
					};
				};
			};

			mt6379_auxadc_1: auxadc {
				compatible = "mediatek,pmic-auxadc-1", "mediatek,mt6379-auxadc-1";
				interrupts = <0x6c>;
