	wla: wla@10461000 {
		compatible = "mediatek,wla";
		reg = <0x00 0x10461000 0x00 0x1000 0x00 0x10561000 0x00 0x1000>;
		wla-enable = <0x01>;
		init-setting-ver = "depend_on_chipid_ver_a";
