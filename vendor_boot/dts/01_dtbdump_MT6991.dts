			ch_5: ch-5 {
				sig-sel = <0x03>;
				bit-sel = <0x04>;
				trig-type = <0x02>;
				phandle = <0x70>;
			};

			ch_6: ch-6 {
				sig-sel = <0x03>;
				bit-sel = <0x05>;
				trig-type = <0x02>;
				phandle = <0x71>;
			};
