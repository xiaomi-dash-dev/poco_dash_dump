				compatible = "mediatek,mt6316-15-regulator";
				buck-size = <0x03>;
				phandle = <0x2ab>;

				mt6316_15_vbuck1: 15-vbuck1 {
					regulator-compatible = "vbuck1";
					regulator-name = "15_vbuck1";
					regulator-min-microvolt = <0x61a80>;
					regulator-max-microvolt = <0x137478>;
					regulator-enable-ramp-delay = <0x100>;
					regulator-allowed-modes = <0x00 0x01 0x02>;
					regulator-always-on;
					phandle = <0x47>;
				};

				mt6316_15_vbuck3: 15-vbuck3 {
					regulator-compatible = "vbuck3";
					regulator-name = "15_vbuck3";
					regulator-min-microvolt = <0x61a80>;
					regulator-max-microvolt = <0x137478>;
					regulator-enable-ramp-delay = <0x100>;
					regulator-allowed-modes = <0x00 0x01 0x02>;
					regulator-always-on;
					phandle = <0x2ac>;
				};
			};
		};

		mt6379: mt6379@e {
			compatible = "mediatek,mt6379";
			reg = <0x0e 0x00>;
			wakeup-source;
			interrupt-parent = <0x4e>;
			interrupts = <0x47 0x08>;
			interrupt-controller;
			#interrupt-cells = <0x01>;
			#address-cells = <0x01>;
			phandle = <0x5e>;

			dbg {
				compatible = "mediatek,mt6379-dbg";
			};

			mt6379_adc: adc {
				compatible = "mediatek,mt6379-adc";
				#io-channel-cells = <0x01>;
				phandle = <0x53>;
			};

			mt6379_chg: chg {
				compatible = "mediatek,mt6379-charger";
				interrupts = <0x00 0x01 0x08 0x0b 0x12 0x13 0x17 0x1b 0x1f 0x33 0x70 0x40 0x41 0x42 0x06 0x07 0x0a>;
				interrupt-names = "fl_pwr_rdy", "fl_detach", "fl_vbus_ov", "fl_chg_tout", "fl_aicc_done", "fl_pe_done", "fl_wdt", "fl_batpro_done", "fl_bc12_dn", "adc_vbat_mon_ov", "usbid_evt", "otp0", "otp1", "otp2", "fl_bus_chg_rdy", "fl_wlin_chg_rdy", "fl_chg_sysov";
				io-channels = <0x53 0x00 0x53 0x01 0x53 0x02 0x53 0x03 0x53 0x04 0x53 0x05 0x53 0x06 0x53 0x07 0x53 0x08 0x53 0x0f 0x53 0x12 0x53 0x13 0x54 0x15 0x54 0x19>;
				chgdev-name = "primary_chg";
				chg-tmr = <0x0f>;
				chg-tmr-en;
				ircmp-v = <0x00>;
				ircmp-r = <0x00>;
				wdt-time = <0x01>;
				te-en;
				mivr = <0x432380>;
				aicr = <0x7a120>;
				ichg = <0x1e8480>;
				ieoc = <0x249f0>;
				cv = <0x401640>;
				vrec = <0x186a0>;
				chgin-ov = <0x06>;
				bc12-sel = <0x00>;
				nr-port = <0x01>;
				boot-mode = <0x51>;
				phys = <0x55 0x03>;
				phy-names = "usb2-phy";
				usb = <0x56>;
				pmic-uvlo = <0x57>;
				otg-supply = <0x58>;
				phandle = <0x5c>;

				mt6379_otg_vbus: usb-otg-vbus-regulator {
					regulator-name = "mt6379-usb-otg-vbus";
					regulator-min-microvolt = <0x4a0150>;
					regulator-max-microvolt = <0x53ec60>;
					regulator-min-microamp = <0x7a120>;
					regulator-max-microamp = <0x27ac40>;
					phandle = <0x58>;
				};
			};

			regulator {
				compatible = "mediatek,mt6379-regulator";
				regulator-name = "mt6379-buckboost";
				regulator-min-microvolt = <0x1ee628>;
				regulator-max-microvolt = <0x4f5880>;
				regulator-allowed-modes = <0x00 0x01>;
				regulator-allow-bypass;
				regulator-always-on;
			};

			led-controller {
				compatible = "mediatek,mt6379-flash";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				interrupts = <0x4b 0x4d 0x4e 0x4f 0x52 0x53 0x54>;
				interrupt-names = "fled_lvf", "fled_bubo_vin_thro", "fled_thermal_thro", "fled_bubo_il_thro", "fled3_short", "fled2_short", "fled1_short";

				led@0 {
					reg = <0x00>;
					function = "flash";
					color = <0x00>;
					function-enumerator = <0x01>;
					led-max-microamp = <0x61a80>;
					flash-max-microamp = <0x16e360>;
					type = <0x00>;
					ct = <0x00>;
					part = <0x00>;

					port@0 {

						fl_core_0: endpoint {
							remote-endpoint = <0x59>;
							phandle = <0x210>;
						};
					};
				};

				led@1 {
					reg = <0x01>;
					function = "flash";
					color = <0x00>;
					function-enumerator = <0x02>;
					led-max-microamp = <0x61a80>;
					flash-max-microamp = <0x16e360>;
					type = <0x00>;
					ct = <0x01>;
					part = <0x00>;

					port@1 {

						fl_core_1: endpoint {
							remote-endpoint = <0x5a>;
							phandle = <0x211>;
						};
					};
				};

				led@2 {
					reg = <0x02>;
					function = "flash";
					color = <0x00>;
					function-enumerator = <0x03>;
					led-max-microamp = <0x61a80>;
					flash-max-microamp = <0x16e360>;
					type = <0x00>;
					ct = <0x02>;
					part = <0x00>;

					port@2 {

						fl_core_2: endpoint {
							remote-endpoint = <0x5b>;
							phandle = <0x212>;
						};
					};
				};
			};

			ufcs {
				compatible = "mediatek,mt6379-ufcs";
				interrupts = <0x7f>;
				status = "disable";
			};

			mt6379_typec: tcpc {
				compatible = "mediatek,mt6379-tcpc";
				interrupts = <0x78>;
				interrupt-names = "pd_evt";
				tcpc,name = "type_c_port0";
				tcpc,role-def = <0x05>;
				tcpc,rp-level = <0x01>;
				tcpc,vconn-supply = <0x01>;
				io-channels = <0x53 0x0e 0x53 0x0f>;
				charger = <0x5c>;
				tcpc,en-ctd;
				tcpc,en-typec-otp;
				wd,sbu-calib-init = <0x4b0>;
				wd,sbu-pl-bound = <0xc8>;
				wd,sbu-pl-lbound-c2c = <0x44c>;
				wd,sbu-pl-ubound-c2c = <0xa28>;
				wd,sbu-ph-auddev = <0x64>;
				wd,sbu-ph-lbound = <0x378>;
				wd,sbu-ph-lbound1-c2c = <0xb22>;
				wd,sbu-ph-ubound1-c2c = <0xc4e>;
				wd,sbu-ph-ubound2-c2c = <0xed8>;
				wd,sbu-aud-ubound = <0x640>;
				wd,wd0-tsleep = <0x01>;
				wd,wd0-tdet = <0x03>;
				phandle = <0x2ad>;

				pd-data {
					pd,vid = <0x2717>;
					pd,pid = <0x6379>;
					pd,source-cap-ext = [cf 29 79 63 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 05 00];
					pd,sink-cap-ext = <0xcf297963 0x00 0x100 0x00 0x10b0164 0x64000000>;
					pd,mfrs = "RichtekTCPC";
					pd,charging-policy = <0x02>;
					pd,source-pdo-size = <0x01>;
					pd,source-pdo-data = <0x19064>;
					pd,sink-pdo-size = <0x03>;
					pd,sink-pdo-data = <0x1912c 0x2d12c 0xc1902464>;
					pd,id-vdo-size = <0x06>;
