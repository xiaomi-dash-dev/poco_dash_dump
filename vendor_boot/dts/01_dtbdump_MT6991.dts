		blender2 = "/soc/disp-ovl0-blender2@328f0000";
		blender3 = "/soc/disp-ovl0-blender3@32900000";
		blender4 = "/soc/disp-ovl0-blender4@32910000";
		blender5 = "/soc/disp-ovl0-blender5@32920000";
		blender6 = "/soc/disp-ovl0-blender6@32930000";
		blender7 = "/soc/disp-ovl0-blender7@32940000";
		blender8 = "/soc/disp-ovl0-blender8@32950000";
		blender9 = "/soc/disp-ovl0-blender9@32960000";
		blender10 = "/soc/disp-ovl1-blender0@32cd0000";
		blender11 = "/soc/disp-ovl1-blender1@32ce0000";
		blender12 = "/soc/disp-ovl1-blender2@32cf0000";
		blender13 = "/soc/disp-ovl1-blender3@32d00000";
		blender14 = "/soc/disp-ovl1-blender4@32d10000";
		blender15 = "/soc/disp-ovl1-blender5@32d20000";
		blender16 = "/soc/disp-ovl1-blender6@32d30000";
		blender17 = "/soc/disp-ovl1-blender7@32d40000";
		blender18 = "/soc/disp-ovl1-blender8@32d50000";
		blender19 = "/soc/disp-ovl1-blender9@32d60000";
		outproc0 = "/soc/disp-ovl0-outproc0@32970000";
		outproc1 = "/soc/disp-ovl0-outproc1@32980000";
		outproc2 = "/soc/disp-ovl0-outproc2@32990000";
		outproc3 = "/soc/disp-ovl0-outproc3@329a0000";
		outproc4 = "/soc/disp-ovl0-outproc4@329b0000";
		outproc5 = "/soc/disp-ovl0-outproc5@329c0000";
		outproc6 = "/soc/disp-ovl1-outproc0@32d70000";
		outproc7 = "/soc/disp-ovl1-outproc1@32d80000";
		outproc8 = "/soc/disp-ovl1-outproc2@32d90000";
		outproc9 = "/soc/disp-ovl1-outproc3@32da0000";
		outproc10 = "/soc/disp-ovl1-outproc4@32db0000";
		outproc11 = "/soc/disp-ovl1-outproc5@32dc0000";
		splitter0 = "/soc/disp1-splitter0@32550000";
		splitter1 = "/soc/disp1-splitter1@32560000";
		disp-dvo0 = "/soc/disp-dvo0@324c0000";
		dsi0 = "/soc/dsi@32490000";
		dsi1 = "/soc/dsi@324a0000";
		dsi2 = "/soc/dsi@324b0000";
		y2r0 = "/soc/disp-y2r0@32210000";
		mdp-rdma0 = "/soc/disp-mdp-rdma0@32170000";
		mdp-rdma1 = "/soc/disp-mdp-rdma1@325e0000";
		mutex0 = "/soc/disp1-mutex0@32020000";
		merge0 = "/soc/disp-merge0@324d0000";
		wdma10 = "/soc/disp-wdma0@329f0000";
		wdma11 = "/soc/disp-wdma2@32a00000";
		wdma12 = "/soc/disp-wdma0@32df0000";
		wdma13 = "/soc/disp-wdma2@32e00000";
		mml-wrot0 = "/soc/mml1-wrot0@3e4f0000";
		mml-wrot1 = "/soc/mml1-wrot2@3e510000";
		mml-wrot2 = "/soc/mml0-wrot0@3e0f0000";
		mml-wrot3 = "/soc/mml0-wrot2@3e110000";
		mml-mutex0 = "/soc/mml0-mutex0@3e020000";
		mml-mutex1 = "/soc/mml1-mutex0@3e420000";
		mtksmmu0 = "/soc/iommu@30800000";
		mtksmmu1 = "/soc/iommu@48600000";
		mtksmmu2 = "/soc/iommu@4c000000";
		mtksmmu3 = "/soc/iommu@14900000";
		dp-intf0 = "/soc/disp1-dp-intf0@32430000";
		dp-intf1 = "/soc/disp1-dp-intf1@32440000";
		tdshp0 = "/soc/disp-tdshp0@321e0000";
		tdshp1 = "/soc/disp-tdshp1@321f0000";
		color0 = "/soc/disp-color0@320f0000";
		color1 = "/soc/disp-color1@32100000";
		ccorr0 = "/soc/disp-ccorr0@32090000";
		ccorr1 = "/soc/disp-ccorr1@320a0000";
		ccorr2 = "/soc/disp-ccorr2@320b0000";
		ccorr3 = "/soc/disp-ccorr3@320c0000";
		c3d0 = "/soc/disp-c3d0@32050000";
		c3d1 = "/soc/disp-c3d1@32060000";
		c3d2 = "/soc/disp-c3d2@32070000";
		c3d3 = "/soc/disp-c3d3@32080000";
		aal0 = "/soc/disp-aal0@32030000";
		aal1 = "/soc/disp-aal1@32040000";
		maal0 = "/soc/disp-mdp-aal0@32150000";
		maal1 = "/soc/disp-mdp-aal1@32160000";
		gamma0 = "/soc/disp-gamma0@32130000";
		gamma1 = "/soc/disp-gamma1@32140000";
		dither0 = "/soc/disp-dither0@32110000";
		dither1 = "/soc/disp-dither1@32120000";
		dither2 = "/soc/disp-dither2@32530000";
		chist0 = "/soc/disp-chist0@320d0000";
		chist1 = "/soc/disp-chist1@320e0000";
		spr0 = "/soc/disp-spr@321c0000";
		postalign0 = "/soc/disp-postalign0@32520000";
		oddmr0 = "/soc/disp-oddmr0@32500000";
		mdp-rsz0 = "/soc/disp-rsz0@321a0000";
		mdp-rsz1 = "/soc/disp-rsz1@321b0000";
		mdp-rsz2 = "/soc/ovl-rsz0@329d0000";
		mdp-rsz4 = "/soc/ovl1-rsz0@32dd0000";
		postmask0 = "/soc/disp-postmask0@32180000";
		postmask1 = "/soc/disp-postmask1@32190000";
		dsc0 = "/soc/disp1-dsc-wrap0@32450000";
		dsc1 = "/soc/disp1-dsc-wrap1@32460000";
		dsc2 = "/soc/disp1-dsc-wrap2@32470000";
		dsc3 = "/soc/disp1-dsc-wrap3@32480000";
		r2y0 = "/soc/disp-r2y@32540000";
	};

	aov: aov {
		compatible = "mediatek,aov";
		status = "okay";
		op-mode = <0x01>;
		mediatek,larbs-uisp = <0x02>;
		mediatek,larbs-mae = <0x03>;
		mae = <0x04>;
		scp-dvfs-supply = <0x05>;
		mae-supply = <0x04>;
		sensor-i2c = <0x06>;
		ulposc-support;
		vlp-base = <0x1c016000>;
		ulposc-cali-register = <0x2c0 0x2c4 0x2c8>;
		ulposc-cali-config = <0xd233340 0x10000800 0x484f>;
		ulposc-cali-result = <0x00 0x42000800 0x484f>;
		ulposc-cali-config-num = <0x03>;
		ulposc-cali-target = <0x104>;
		ulposc-result-target = <0x1a>;
		ulposc-cali-fmeter-id = <0x32>;
		ulposc-result-fmeter-id = <0x3f>;
		apu-supply = <0x07>;
		phandle = <0x1c7>;
	};

	camfe: camfe {
		compatible = "mediatek,mt8678-cam-fe";
		mtk,smmu-shared = <0x08>;
		mediatek,larbs = <0x09 0x0a 0x0b>;
		clocks = <0x0c 0x03 0x0c 0x06 0x0c 0x09 0x0d 0x13 0x0d 0x17 0x0d 0x2c 0x0d 0x2f 0x0d 0x41 0x0d 0x43 0x0d 0x4b 0x0d 0x4f 0x0e 0x02 0x0e 0x04 0x0e 0x06 0x0f 0x02 0x0f 0x04 0x0f 0x06>;
		clock-names = "VCORE_MAIN", "VCORE_SUB0", "VCORE_SUB1", "IMG_WPE0", "IMG_WPE1", "IMG_SUB_COMMON0", "IMG_SUB_COMMON1", "IMG_GALS_RX_WPE0", "IMG_GALS_RX_WPE1", "IMG26", "IMG_GALS", "WPE1_DIP1_LARB11", "WPE1_DIP1_WPE", "WPE1_DIP1_GALS0", "WPE2_DIP1_LARB11", "WPE2_DIP1_WPE", "WPE2_DIP1_GALS0";
		status = "disabled";
		phandle = <0x248>;
	};

	cache-parity {
		compatible = "mediatek,mt6985-cache-parity";
		ecc-irq-support = <0x01>;
		arm-dsu-ecc-hwirq = <0x30>;
		interrupts = <0x00 0x00 0x04 0x00 0x00 0x01 0x04 0x00 0x00 0x02 0x04 0x00 0x00 0x03 0x04 0x00 0x00 0x04 0x04 0x00 0x00 0x05 0x04 0x00 0x00 0x06 0x04 0x00 0x00 0x07 0x04 0x00 0x00 0x10 0x04 0x00>;
	};

	chosen: chosen {
		bootargs = "console=tty0 root=/dev/ram \t\t\t    nosoftlockup kasan.page_alloc.sample=1 \t\t\t    8250.nr_uarts=6 \t\t\t    androidboot.hardware=mt6991 log_buf_len=8m\t\t\t    vmalloc=400M swiotlb=noforce\t\t\t    firmware_class.path=/vendor/firmware,/odm/firmware \t\t\t    cgroup.memory=nosocket,nokmem \t\t\t    disable_dma32=on \t\t\t    transparent_hugepage=never \t\t\t    kvm-arm.protected_modules=pkvm_mgmt,pkvm_tmem,pkvm_smmu,pkvm_mkp";
		mkp_panic = "on";
		kaslr-seed = <0x00 0x00>;
		phandle = <0x51>;
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu0: cpu@0 {
			device_type = "cpu";
			reg = <0x00>;
			performance-domains = <0x10 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x2ca>;
			cpu-idle-states = <0x11 0x12 0x13 0x14 0x15>;
			phandle = <0x1c>;
		};

		cpu1: cpu@1 {
			device_type = "cpu";
			reg = <0x100>;
			performance-domains = <0x10 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x2ca>;
			cpu-idle-states = <0x11 0x12 0x13 0x14 0x15>;
			phandle = <0x1d>;
		};

		cpu2: cpu@2 {
			device_type = "cpu";
			reg = <0x200>;
			performance-domains = <0x10 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x2ca>;
			cpu-idle-states = <0x11 0x12 0x13 0x14 0x15>;
			phandle = <0x1e>;
		};

		cpu3: cpu@3 {
			device_type = "cpu";
			reg = <0x300>;
			performance-domains = <0x10 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x2ca>;
			cpu-idle-states = <0x11 0x12 0x13 0x14 0x15>;
			phandle = <0x1f>;
		};

		cpu4: cpu@100 {
			device_type = "cpu";
			reg = <0x400>;
			performance-domains = <0x10 0x01>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			cpu-idle-states = <0x16 0x17 0x18 0x14 0x15>;
			phandle = <0x20>;
		};

		cpu5: cpu@101 {
			device_type = "cpu";
			reg = <0x500>;
			performance-domains = <0x10 0x01>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			cpu-idle-states = <0x16 0x17 0x18 0x14 0x15>;
			phandle = <0x21>;
		};

		cpu6: cpu@102 {
			device_type = "cpu";
			reg = <0x600>;
			performance-domains = <0x10 0x01>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			cpu-idle-states = <0x16 0x17 0x18 0x14 0x15>;
			phandle = <0x22>;
		};

		cpu7: cpu@200 {
			device_type = "cpu";
			reg = <0x700>;
			performance-domains = <0x10 0x02>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x3a9>;
			cpu-idle-states = <0x19 0x1a 0x1b 0x14 0x15>;
			phandle = <0x23>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x1c>;
				};

				core1 {
					cpu = <0x1d>;
				};

				core2 {
					cpu = <0x1e>;
				};

				core3 {
					cpu = <0x1f>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x20>;
				};

				core1 {
					cpu = <0x21>;
				};

				core2 {
					cpu = <0x22>;
				};
			};

			cluster2 {

				core0 {
					cpu = <0x23>;
				};
			};
		};

		idle-states {
			entry-method = "arm,psci";

			cpuoff_l: cpuoff-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x5c>;
				exit-latency-us = <0xa7>;
				min-residency-us = <0x1eb4>;
				phandle = <0x11>;
			};

			cpuoff_m: cpuoff-m {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x44>;
				exit-latency-us = <0x97>;
				min-residency-us = <0xe88>;
				phandle = <0x16>;
			};

			cpuoff_b: cpuoff-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x3e>;
				exit-latency-us = <0xa0>;
				min-residency-us = <0xba4>;
				phandle = <0x19>;
			};

			clusteroff_l: clusteroff-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <0xc0>;
				exit-latency-us = <0x10b>;
				min-residency-us = <0x1eb4>;
				phandle = <0x12>;
			};

			clusteroff_m: clusteroff-m {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <0xa9>;
				exit-latency-us = <0x101>;
				min-residency-us = <0xe88>;
				phandle = <0x17>;
			};

			clusteroff_b: clusteroff-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <0xa7>;
				exit-latency-us = <0xfd>;
				min-residency-us = <0xd70>;
				phandle = <0x1a>;
			};

			mcusysoff_l: mcusysoff-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x2010007>;
				local-timer-stop;
				entry-latency-us = <0x27c>;
				exit-latency-us = <0x40c>;
				min-residency-us = <0x1eb4>;
				phandle = <0x13>;
			};

			mcusysoff_m: mcusysoff-m {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x2010007>;
				local-timer-stop;
				entry-latency-us = <0x232>;
				exit-latency-us = <0x3dd>;
				min-residency-us = <0xe88>;
				phandle = <0x18>;
			};

			mcusysoff_b: mcusysoff-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x2010007>;
				local-timer-stop;
				entry-latency-us = <0x21e>;
				exit-latency-us = <0x3d5>;
				min-residency-us = <0xd70>;
				phandle = <0x1b>;
			};

			system_vcore: system-vcore {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x20100ff>;
				local-timer-stop;
				entry-latency-us = <0x3ac>;
				exit-latency-us = <0xdac>;
				min-residency-us = <0x8980>;
				phandle = <0x14>;
			};

			s2idle: s2idle {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x20180ff>;
				local-timer-stop;
				entry-latency-us = <0x2710>;
				exit-latency-us = <0x2710>;
				min-residency-us = <0xffffffff>;
				phandle = <0x15>;
			};
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	dbg-error-flag {
		compatible = "mediatek,dbg-error-flag";
		mediatek,error-flag = <0x24 0x25>;
	};

	clk_ao: clk-ao {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		phandle = <0x249>;
	};

	clkitg: clkitg {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		status = "okay";
		phandle = <0x24a>;

		bring-up@0 {
			compatible = "mediatek,clk-bring-up";
			reg = <0x00>;
		};
	};

	disable_unused: disable-unused {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		status = "okay";
		phandle = <0x24b>;

		disable-unused-clk-audiosys@88 {
			compatible = "mediatek,clk-disable-unused";
			reg = <0x88>;
			power-domains = <0x26 0x0f>;
		};

		disable-unused-clk-pextp1cfg-ao@8b {
			compatible = "mediatek,clk-disable-unused";
			reg = <0x8b>;
			clocks = <0x27 0x01 0x27 0x03 0x27 0x05 0x27 0x07 0x27 0x09 0x27 0x0b 0x27 0x0d 0x27 0x0f 0x27 0x11 0x27 0x13 0x27 0x15 0x27 0x17 0x27 0x19 0x27 0x1b 0x27 0x1d 0x27 0x1f>;
		};

		disable-unused-clk-pextp0cfg-ao@8c {
			compatible = "mediatek,clk-disable-unused";
			reg = <0x8c>;
			clocks = <0x28 0x01 0x28 0x03 0x28 0x05 0x28 0x07 0x28 0x09 0x28 0x0b 0x28 0x0d 0x28 0x0f>;
		};

		disable-unused-clk-ufscfg-ao@8d {
			compatible = "mediatek,clk-disable-unused";
			reg = <0x8d>;
			clocks = <0x29 0x01 0x29 0x03 0x29 0x05 0x29 0x07 0x29 0x09 0x29 0x0b 0x29 0x0d 0x29 0x0f>;
		};

		disable-unused-clk-pericfg-ao@8e {
			compatible = "mediatek,clk-disable-unused";
