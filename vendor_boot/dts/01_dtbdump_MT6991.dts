	vtskin: vtskin {
		compatible = "mediatek,mt6991-virtual-tskin";
		#thermal-sensor-cells = <0x01>;
		phandle = <0x243>;
	};

	touch_tui0: touch-tui0 {
		compatible = "mediatek,tui_common";
		tui-is-registered = <0x01>;
		phandle = <0x53b>;
	};

	pps: pps {
		compatible = "pps-gpio";
		phandle = <0x53c>;
	};

	nebula_mbox0: nebula-mbox@0 {
		way = <0x00>;
		reg = <0x00 0x00 0x00 0x00>;
		compatible = "grt,ipc-mbox";
		#mbox-cells = <0x01>;
		status = "disabled";
		phandle = <0x244>;
	};

	pwritg: pwritg {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		status = "disabled";
		phandle = <0x53d>;
	};

	power_service0: power-service@0 {
		compatible = "grt,power-service";
		reg = <0x00 0x00 0x00 0x00>;
		mboxes = <0x244 0x00 0x244 0x01 0x244 0x02 0x244 0x03 0x244 0x04>;
		status = "disabled";
		phandle = <0x53e>;
	};

	pkvm: pkvm {
		status = "disable";
		phandle = <0x53f>;
	};

	trusty: trusty {
		compatible = "android,trusty-smc-v1";
		ranges;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		tee-id = <0x00>;
		tee-name = "trusty";
		phandle = <0x540>;

		trusty_virtio: trusty-virtio {
			compatible = "android,trusty-virtio-v1";
			phandle = <0x15c>;
		};

		trusty_irq: trusty-irq {
			compatible = "android,trusty-irq-v1";
			ppi-interrupt-parent = <0x01>;
			phandle = <0x245>;
		};

		tz_system: tz-system {
			compatible = "mediatek,trusty-tz";
			virtio-supply = <0x15c>;
			irq-supply = <0x245>;
			phandle = <0x246>;
		};

		mtee: mtee {
			compatible = "mediatek,trusty-mtee-v1";
			tz-supply = <0x246>;
			phandle = <0x541>;
		};

		trusty-gz-log {
			compatible = "android,trusty-gz-log-v1";
		};

		trusty-sapu {
			compatible = "mediatek,trusty-sapu";
			power-version = <0x02>;
			datamem-type = <0x02>;
			datamem-size = <0x00 0x00>;
			smmu-device = <0x247>;
			status = "okay";
		};
	};

	nebula: nebula {
		compatible = "android,nebula-smc-v1";
		ranges;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		tee-id = <0x01>;
		tee-name = "nebula";
		phandle = <0x542>;

		nebula-virtio {
			compatible = "android,nebula-virtio-v1";
		};

		nebula-irq {
			compatible = "android,nebula-irq-v1";
			ppi-interrupt-parent = <0x01>;
		};

		nebula-gz-log {
			compatible = "android,nebula-gz-log-v1";
		};
	};

	hypervisor: hypervisor {
		compatible = "mediatek,geniezone-hyp", "mediatek,geniezone";
		status = "okay";
		phandle = <0x543>;
	};

