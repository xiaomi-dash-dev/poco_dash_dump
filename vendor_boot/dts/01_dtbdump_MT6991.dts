		monitor-hw-sta-max = <0x03>;
		dbg-latch-hw-max = <0x06>;
		dbg-latch-sta-hw-max = <0x03>;
		monitor-channel = <0x6b 0x6c 0x6d 0x6e 0x6f 0x70 0x71>;
		monitor-status = <0x72 0x73 0x74>;
		dbg-latch = <0x75 0x76 0x77 0x78 0x79 0x7a>;
