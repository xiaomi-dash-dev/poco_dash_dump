/dts-v1/;

/ {
	model = "MT6991";
	compatible = "mediatek,MT6991";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;

	aliases {
		i2c0 = "/soc/i2c@13130000";
		i2c1 = "/soc/i2c@13930000";
		i2c2 = "/soc/i2c@139b0000";
		i2c3 = "/soc/i2c@13150000";
		i2c4 = "/soc/i2c@13a30000";
		i2c5 = "/soc/i2c@120a0000";
