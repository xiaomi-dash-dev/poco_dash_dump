		funnel0: funnel0 {
			compatible = "arm,coresight-static-funnel";
			phandle = <0x43c>;

			in-ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					funnel0_in0: endpoint {
